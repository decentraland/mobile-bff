# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=3000
HTTP_SERVER_HOST=0.0.0.0

# reset metrics at 00:00UTC
WKC_METRICS_RESET_AT_NIGHT=false

# Database Configuration
PG_COMPONENT_PSQL_PORT=5432
PG_COMPONENT_PSQL_HOST=localhost
PG_COMPONENT_PSQL_DATABASE=mobile
PG_COMPONENT_PSQL_USER=postgres
PG_COMPONENT_PSQL_PASSWORD=postgres

# Slack Webhook for deletion request notifications
SLACK_WEBHOOK_URL=

# Comma-separated list of wallet addresses allowed to use backoffice endpoints
# Default includes the dev identity from mobile-curation (Hardhat account #0)
ALLOWED_USERS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Test Auth for Apple App Store review
# Set these in production .env; leave empty to disable test auth endpoints.
TEST_AUTH_EMAIL=
TEST_AUTH_OTP_CODE=
TEST_AUTH_PRIVATE_KEY=

# Destinations API configuration
DESTINATIONS_API_URL=https://places.decentraland.org/api/destinations
DESTINATIONS_CACHE_TTL_MS=7200000

# Events API configuration
EVENTS_API_URL=https://events.decentraland.org/api/events
EVENTS_CACHE_TTL_MS=7200000

# ---- Wallets (Thirdweb sign-message thin proxy) ----
# Server-only secret; never ship to clients.
THIRDWEB_SECRET_KEY=
THIRDWEB_CLIENT_ID=

# ---- Attestation: Apple App Attest ----
# Apple-style appId: <TEAM_ID>.<bundle.id>. Required.
APP_ATTEST_APP_ID=
# "development" for sandbox-attested keys, "production" for App Store builds.
APP_ATTEST_ENV=development

# ---- Attestation: Google Play Integrity ----
PLAY_INTEGRITY_PACKAGE_NAME=
# Comma-separated list. Common values: MEETS_DEVICE_INTEGRITY, MEETS_BASIC_INTEGRITY, MEETS_STRONG_INTEGRITY.
PLAY_INTEGRITY_REQUIRED_VERDICTS=MEETS_DEVICE_INTEGRITY
# Path to a GCP service-account JSON with the Play Integrity API scope.
# googleapis picks this up automatically when GOOGLE_APPLICATION_CREDENTIALS is set.
GOOGLE_APPLICATION_CREDENTIALS=
