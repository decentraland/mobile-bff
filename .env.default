# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=3000
HTTP_SERVER_HOST=0.0.0.0

# reset metrics at 00:00UTC
WKC_METRICS_RESET_AT_NIGHT=false

# Database Configuration
PG_COMPONENT_PSQL_PORT=5432
PG_COMPONENT_PSQL_HOST=localhost
PG_COMPONENT_PSQL_DATABASE=mobile
PG_COMPONENT_PSQL_USER=postgres
PG_COMPONENT_PSQL_PASSWORD=postgres

# Slack Webhook for deletion request notifications
SLACK_WEBHOOK_URL=

# Magic Link admin secret. Required — boot will fail if unset. POST /deletion
# uses it to trigger Magic wallet deletion for the requesting address.
MAGIC_SECRET_KEY=
# Optional override for the Magic API base URL (default: https://api.magic.link)
MAGIC_API_BASE=

# Comma-separated list of wallet addresses allowed to use backoffice endpoints
# Default includes the dev identity from mobile-curation (Hardhat account #0)
ALLOWED_USERS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Test Auth for Apple App Store review
# Set these in production .env; leave empty to disable test auth endpoints.
TEST_AUTH_EMAIL=
TEST_AUTH_OTP_CODE=
TEST_AUTH_PRIVATE_KEY=

# Destinations API configuration
DESTINATIONS_API_URL=https://places.decentraland.org/api/destinations
DESTINATIONS_CACHE_TTL_MS=7200000

# Thumbnail a comeback push carries, resolved when the push is sent rather than carried from
# the warehouse. A lookup that fails sends the campaign's own image instead of holding the row.
PLACES_API_URL=https://places.decentraland.org/api/places
PLACE_THUMBNAIL_CACHE_TTL_MS=21600000
PLACE_THUMBNAIL_TIMEOUT_MS=3000

# Events API configuration
EVENTS_API_URL=https://events.decentraland.org/api/events
EVENTS_CACHE_TTL_MS=7200000

# Deployment environment ("dev", "stg", "prd"). Injected by definitions in
# deployed envs; unset locally. Drives APP_ATTEST_ENV default when that one
# is unset ("prd" -> production, anything else -> any).
ENV=

# ---- Wallets (Thirdweb sign-message thin proxy) ----
# Server-only secret; never ship to clients.
THIRDWEB_SECRET_KEY=
# Public identifier (analogous to a Stripe publishable key); safe to commit.
# Restrict abuse via Bundle ID allowlist in the Thirdweb dashboard.
THIRDWEB_CLIENT_ID=e1adce863fe287bb6cf0e3fd90bdb77f
# Override the upstream URL (defaults to https://api.thirdweb.com/v1/wallets/sign-message).
# Useful for pointing at a staging Thirdweb instance during testing.
THIRDWEB_API_BASE_URL=

# ---- Attestation: Apple App Attest ----
# Apple-style appId: <TEAM_ID>.<bundle.id>. Required.
APP_ATTEST_APP_ID=8T73XM973P.org.decentraland.godotexplorer
# "development" (sandbox-attested keys only), "production" (App Store /
# TestFlight only), or "any" (accept either AAGUID — useful when the same
# backend serves local dev and TestFlight). If unset, derived from ENV
# ("prd" -> production, anything else -> any).
APP_ATTEST_ENV=

# ---- Attestation: Google Play Integrity ----
PLAY_INTEGRITY_PACKAGE_NAME=org.decentraland.godotexplorer
# Comma-separated list. Common values (loosest -> strictest):
#   MEETS_BASIC_INTEGRITY  -> permissive, accepts rooted devices that pass surface-level checks
#   MEETS_DEVICE_INTEGRITY -> baseline; requires unmodified OS, locked bootloader  (default)
#   MEETS_STRONG_INTEGRITY -> strictest; requires hardware-backed attestation
#
# Default is MEETS_DEVICE_INTEGRITY. MEETS_STRONG_INTEGRITY requires
# hardware-backed key attestation, which a large share of real devices in the
# field do not have — setting it as the default would lock out legitimate
# users. Raise the bar to STRONG only for environments where you control the
# device fleet (e.g. dedicated hardware tests).
PLAY_INTEGRITY_REQUIRED_VERDICTS=MEETS_DEVICE_INTEGRITY
# Whether appRecognitionVerdict must equal PLAY_RECOGNIZED. Production: true.
# Dev/staging with unsigned APKs will get UNRECOGNIZED_VERSION and fail — set
# this to "false" there. Any value other than the literal string "false" is
# treated as true so the strict default holds when this var is unset.
PLAY_INTEGRITY_REQUIRE_PLAY_RECOGNIZED=true
# ---- Push notifications (FCM) ----
# Service-account credentials for Firebase Cloud Messaging, base64-encoded.
# Needs only the "Firebase Cloud Messaging API Admin" role -- not the Firebase
# Admin SDK key, which also opens Auth, Firestore and Storage.
# Generate with: base64 -i fcm-sa.json | tr -d '\n'
FCM_SA_JSON=
# How often the dispatcher looks for work, and how many sends it keeps in flight.
# FCM has no batch endpoint, so this is one HTTP request per token.
# 0 or less disables the background loop entirely (used by the integration tests).
PUSH_DISPATCH_INTERVAL_MS=5000
PUSH_DISPATCH_BATCH_SIZE=200
PUSH_DISPATCH_CONCURRENCY=25
# Comma-separated device tokens (FCM or APNs, told apart by shape) that
# POST /backoffice/push/campaigns/:id/test falls back to when the request does not name
# recipients. Placeholder for a decision that is still open (who the team test list is); a
# caller can always pass their own device token instead.
PUSH_TEST_TOKENS=
# ---- Push notifications (APNs) ----
# Auth key from the developer portal (Certificates, Identifiers & Profiles -> Keys), base64
# of the .p8 file. One key serves every app of the team and does not expire.
# Generate with: base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
# Leave empty where iOS is not set up: iOS deliveries then fail with APNS_NOT_CONFIGURED
# instead of the service refusing to start.
APNS_KEY_P8=
# The 10-character Key ID shown next to the key, and the Apple Developer Team ID.
APNS_KEY_ID=
APNS_TEAM_ID=
# Sent as apns-topic: the app's bundle id.
APNS_BUNDLE_ID=org.decentraland.godotexplorer
# production for TestFlight and App Store builds (the default). sandbox only reaches tokens
# from a development-signed build.
APNS_ENVIRONMENT=production

# Service-account credentials for the Play Integrity API, base64-encoded.
# Generate with: base64 -i play-integrity-sa.json | tr -d '\n'
PLAY_INTEGRITY_SA_JSON=

# ---- Attestation: session token ----
# 256-bit secret used to HMAC session tokens issued by POST /attest/session.
# Generate: openssl rand -base64 32
# Rotating this invalidates every outstanding session token.
ATTESTATION_SESSION_SECRET=
# TTL of issued tokens in milliseconds. Default 48h (172800000). Longer
# TTL means fewer Play Integrity calls but a wider replay window if a
# token is exfiltrated.
ATTESTATION_SESSION_TTL_MS=172800000

# ---- Push notifications (warehouse audience feed) ----
# Snowflake reader for DCL_NEXT.EXPORTS.EXPORT_PUSH_COMEBACK_AUDIENCE, the feed that says which
# installs are due a lifecycle push today, where to send each one and at what time. See
# decentraland/monodata (dwh-next/models/exports/push-feed).
#
# Account identifier including region, as it appears in the hostname.
SNOWFLAKE_ACCOUNT=
# Service user and its role, both created by the warehouse's Pulumi stack.
SNOWFLAKE_USER=PUSH_FEED
SNOWFLAKE_ROLE=DCL_NEXT_ROLE_EXPORT_PUSH_FEED
SNOWFLAKE_WAREHOUSE=DCL_NEXT_WH_EXPORTS
SNOWFLAKE_DATABASE=DCL_NEXT
SNOWFLAKE_SCHEMA=EXPORTS
# The PKCS#8 private key, PEM, exactly as the warehouse stack wrote it to SSM — not base64.
# Newlines are preserved if the secret store keeps them and restored if it does not.
# Leave empty where the warehouse is not reachable: the feed sync then logs and does nothing
# instead of the service refusing to start.
SNOWFLAKE_PRIVATE_KEY=
# How often the feed is read. The build behind it runs once a day, so this only decides how
# soon a row that came due is picked up. 0 or less disables the background loop entirely
# (used by the integration tests).
PUSH_FEED_SYNC_INTERVAL_MS=900000
