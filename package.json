{
  "name": "@dcl-regenesislabs/mobile-bff",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "test:unit": "jest --forceExit --detectOpenHandles --coverage --verbose test/unit",
    "dev": "nodemon",
    "migrate": "node-pg-migrate --tsconfig ./tsconfig.json --migrations-dir ./src/migrations",
    "docs:generate": "redocly build-docs openapi.yaml -o docs/api.html",
    "docs:lint": "redocly lint openapi.yaml",
    "docs:preview": "redocly preview-docs openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.17",
    "@types/node": "^20.14.2",
    "@types/node-forge": "^1.3.14",
    "@well-known-components/test-helpers": "^1.5.8",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/core-commons": "^0.10.1",
    "@dcl/crypto": "^3.7.0",
    "@dcl/crypto-middleware": "^6.3.0",
    "@dcl/schemas": "^19.4.0",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/fetch-component": "^3.0.0",
    "@well-known-components/http-server": "^2.1.0",
    "@well-known-components/interfaces": "^1.5.1",
    "@well-known-components/logger": "^3.1.3",
    "@well-known-components/metrics": "^2.1.0",
    "@well-known-components/pg-component": "^1.1.0",
    "cbor-x": "^1.6.4",
    "googleapis": "^172.0.0",
    "node-forge": "^1.4.0",
    "node-pg-migrate": "^6.2.2",
    "nodemon": "^3.1.11",
    "sql-template-strings": "^2.2.2",
    "ts-node": "^10.9.2"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "DEV=true ts-node ./src/index.ts"
  }
}
